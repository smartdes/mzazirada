# ==============================================================================
# MzaziRada Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Africa's Talking Credentials
# Sign up at https://africastalking.com to obtain credentials
# Use 'sandbox' for testing without live telecom charges
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SHORTCODE=*384*73355#

# Security Secret for Google Apps Script Webhook
# Set a strong, random alphanumeric string here.
# The same secret must be configured in Google Apps Script (Script Properties).
WEBHOOK_SECRET=your_secure_random_webhook_secret_here
